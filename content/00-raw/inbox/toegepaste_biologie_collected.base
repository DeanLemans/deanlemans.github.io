properties:
  file.name:
    displayName: links
views:
  - type: table
    name: Table
    filters:
      and:
        - category == "school"
        - '!file.tags.contains("hovenier")'
        - '!file.tags.contains("sintlucas")'
    order:
      - title
      - file.name
      - created
      - modified
      - id
      - file.backlinks
